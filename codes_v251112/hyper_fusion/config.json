{
  "description": "超图融合网络配置示例",
  "model": {
    "encoder_hidden_dim": 256,
    "encoder_output_dim": 256,
    "hypergraph_hidden_dim": 256,
    "num_hyperedges": 64,
    "num_conv_layers": 2,
    "bottleneck_dim": 128,
    "dropout": 0.1,
    "hyperedge_drop_rate": 0.2,
    "use_contrastive": true,
    "use_bottleneck": true,
    "contrastive_weight": 0.1
  },
  "training": {
    "batch_size": 32,
    "epochs": 50,
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "num_workers": 4,
    "seed": 42
  },
  "data": {
    "dataset": "MOSEI",
    "data_dir": "./output/mosei_features_5fps/",
    "emotion": "happy",
    "label_id": 0,
    "train_ratio": 0.7
  }
}
