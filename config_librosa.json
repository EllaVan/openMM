{
  "description": "Configuration using Librosa for audio feature extraction",
  "text": {
    "model": "bert-base-uncased",
    "enabled": true,
    "max_length": 512
  },
  "audio": {
    "model": "librosa",
    "sample_rate": 16000,
    "enabled": true,
    "features": {
      "mfcc": {
        "enabled": true,
        "n_mfcc": 13
      },
      "rms": {
        "enabled": true
      },
      "zero_crossing_rate": {
        "enabled": true
      },
      "spectral_centroid": {
        "enabled": true
      }
    },
    "hop_length": 512
  },
  "video": {
    "model": "mediapipe",
    "fps": 25,
    "enabled": true,
    "max_num_faces": 1,
    "min_detection_confidence": 0.5
  },
  "alignment": {
    "method": "interpolation",
    "enabled": true,
    "reference": "audio"
  }
}
