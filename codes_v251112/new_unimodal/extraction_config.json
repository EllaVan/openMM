{
  "description": "特征提取参数配置",
  "version": "1.0",

  "pca_training": {
    "enabled": true,
    "num_samples": 1000,
    "save_model": true,
    "model_filename": "audio_pca_model.pkl",
    "description": "PCA 训练配置（从数据集采样训练）"
  },

  "batch_processing": {
    "text_batch_size": 16,
    "audio_batch_size": 8,
    "video_batch_size": 32,
    "description": "批处理大小（根据 GPU 显存调整）"
  },

  "memory_optimization": {
    "max_frames": 500,
    "video_frame_batch": 32,
    "enable_cleanup": true,
    "immediate_cpu_transfer": true,
    "description": "内存优化策略"
  },

  "quality_control": {
    "skip_corrupted_files": true,
    "validate_features": true,
    "log_failures": true,
    "description": "质量控制选项"
  },

  "output_format": {
    "save_format": "pickle",
    "compression": false,
    "include_metadata": true,
    "metadata_fields": [
      "sample_id",
      "emotion",
      "label",
      "num_frames",
      "timestamps"
    ],
    "description": "输出格式配置"
  },

  "logging": {
    "level": "INFO",
    "save_to_file": true,
    "filename_pattern": "extraction_{dataset}_{timestamp}.log",
    "include_traceback": true,
    "description": "日志配置"
  },

  "gpu_settings": {
    "device": "cuda",
    "fallback_to_cpu": true,
    "empty_cache_frequency": "per_sample",
    "description": "GPU 设置"
  },

  "emotion_mapping": {
    "happy": 0,
    "happiness": 0,
    "sad": 1,
    "sadness": 1,
    "anger": 2,
    "disgust": 3,
    "surprise": 4,
    "fear": 5,
    "neutral": 6,
    "description": "情感标签映射"
  },

  "presets": {
    "fast": {
      "description": "快速提取（较低质量）",
      "max_frames": 300,
      "pca_samples": 500,
      "video_batch_size": 64
    },
    "balanced": {
      "description": "平衡模式（推荐）",
      "max_frames": 500,
      "pca_samples": 1000,
      "video_batch_size": 32
    },
    "high_quality": {
      "description": "高质量提取（较慢）",
      "max_frames": 800,
      "pca_samples": 2000,
      "video_batch_size": 16
    }
  }
}
