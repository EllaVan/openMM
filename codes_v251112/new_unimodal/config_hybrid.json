{
  "description": "混合特征提取配置 - MiniLM + HuBERT+PCA + ViT-small",
  "version": "1.0",

  "text": {
    "model_name": "microsoft/MiniLM-L6-v2",
    "model_path": "/media/sda/wf/openMM/materials_task/all-MiniLM-L6-v2",
    "max_length": 512,
    "output_dim": 384,
    "description": "文本特征提取器（直接输出 384 维）"
  },

  "audio": {
    "model_name": "facebook/hubert-base-ls960",
    "model_path": "media/sda/pingjm/MTCA/pretraining_model/HuBERT/hubert-base-ls960",
    "sample_rate": 16000,
    "max_duration": 10.0,
    "output_dim": 768,
    "pca_reduction": {
      "enabled": true,
      "target_dim": 384,
      "model_path": null,
      "description": "音频特征先提取 768 维，再用 PCA 降到 384 维"
    },
    "description": "音频特征提取器（768 维 → PCA 384 维）- 优化：max_duration从30降到10秒"
  },

  "video": {
    "model_name": "google/vit-small-patch16-224",
    "model_path": "/media/sda/wf/openMM/materials_task/vit_small_patch16_224.dino",
    "fps": 10,
    "feature_mode": "cls",
    "output_dim": 384,
    "description": "视频特征提取器（直接输出 384 维）- 优化：fps从25降到10，加速2.5x"
  },

  "memory_management": {
    "max_frames": 300,
    "video_batch_size": 64,
    "enable_memory_cleanup": true,
    "description": "内存管理配置 - 优化：max_frames从500降到300，batch从32提到64"
  },

  "output": {
    "text_dim": 384,
    "audio_dim": 384,
    "video_dim": 384,
    "description": "最终输出：所有模态统一 384 维"
  },

  "notes": {
    "file_size": "MOSEI 约 30GB（比 768维 减少 50%）",
    "accuracy_loss": "< 1%",
    "extraction_speed": "比全 768 维快 20%",
    "recommended_for": "平衡性能和存储空间的场景"
  }
}
