{
  "description": "数据集路径配置 - 请根据实际情况修改路径",
  "comment": "支持 MOSEI 和 MELD 数据集的特征提取路径配置",

  "mosei": {
    "dataset_name": "MOSEI",
    "base_dir": "/path/to/MOSEI",
    "label_file": "/path/to/MOSEI/label/label.csv",
    "output_dir": "./output/mosei_features",
    "structure": {
      "comment": "MOSEI 数据集结构说明",
      "audio": "{base_dir}/audio/{video_id}/{clip_id}.wav",
      "video": "{base_dir}/video/{video_id}/{clip_id}.mp4",
      "label": "{base_dir}/label/label.csv"
    },
    "example": {
      "base_dir": "/media/sda/datasets/MOSEI",
      "label_file": "/media/sda/datasets/MOSEI/label/label.csv",
      "output_dir": "./output/mosei_features"
    }
  },

  "meld": {
    "dataset_name": "MELD",
    "base_dir": "/path/to/MELD",
    "output_dir": "./output/meld_features",
    "split": "all",
    "structure": {
      "comment": "MELD 数据集结构说明（每个划分独立）",
      "train": {
        "audio": "{base_dir}/train/audio/{file_id}.wav",
        "video": "{base_dir}/train/video/{file_id}.mp4",
        "label": "{base_dir}/train/label.csv"
      },
      "dev": {
        "audio": "{base_dir}/dev/audio/{file_id}.wav",
        "video": "{base_dir}/dev/video/{file_id}.mp4",
        "label": "{base_dir}/dev/label.csv"
      },
      "test": {
        "audio": "{base_dir}/test/audio/{file_id}.wav",
        "video": "{base_dir}/test/video/{file_id}.mp4",
        "label": "{base_dir}/test/label.csv"
      }
    },
    "example": {
      "base_dir": "/media/sda/datasets/MELD",
      "output_dir": "./output/meld_features",
      "split": "all"
    }
  },

  "hybrid_extraction": {
    "comment": "混合特征提取配置（MiniLM + HuBERT+PCA + ViT-small）",
    "mosei": {
      "base_dir": "/path/to/MOSEI",
      "label_file": "/path/to/MOSEI/label/label.csv",
      "output_dir": "./output/mosei_features_hybrid",
      "pca_training_samples": 1000
    },
    "meld": {
      "base_dir": "/path/to/MELD",
      "output_dir": "./output/meld_features_hybrid",
      "split": "all",
      "pca_training_samples": 1000
    }
  },

  "usage_examples": {
    "mosei_standard": {
      "command": "python unimodal_features/batch_extract_efficient.py --dataset mosei",
      "description": "标准提取（RoBERTa + HuBERT + ViT-base，全768维）"
    },
    "mosei_hybrid": {
      "command": "python unimodal_features/batch_extract_hybrid.py --dataset mosei --train_pca",
      "description": "混合提取（MiniLM + HuBERT+PCA + ViT-small，全384维）"
    },
    "meld_standard": {
      "command": "python unimodal_features/batch_extract_efficient.py --dataset meld --split all",
      "description": "标准提取（RoBERTa + HuBERT + ViT-base，全768维）"
    },
    "meld_hybrid": {
      "command": "python unimodal_features/batch_extract_hybrid.py --dataset meld --split all --train_pca",
      "description": "混合提取（MiniLM + HuBERT+PCA + ViT-small，全384维）"
    }
  },

  "notes": {
    "paths": "请将所有 /path/to/ 替换为实际路径",
    "output": "output_dir 可以是相对路径或绝对路径",
    "split": "MELD 的 split 可选: 'all', 'train', 'dev', 'test'",
    "hybrid": "混合提取需要先下载 MiniLM-L6-v2 和 vit-small-patch16-224"
  }
}
