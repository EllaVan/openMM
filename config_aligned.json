{
  "description": "Aligned configuration for multimodal feature extraction",
  "text": {
    "model": "bert-base-uncased",
    "enabled": true,
    "max_length": 512
  },
  "audio": {
    "model": "wav2vec2",
    "model_name": "facebook/wav2vec2-base-960h",
    "sample_rate": 16000,
    "enabled": true
  },
  "video": {
    "model": "mediapipe",
    "fps": 25,
    "enabled": true,
    "max_num_faces": 1,
    "min_detection_confidence": 0.5
  },
  "alignment": {
    "method": "wav2vec_ctc",
    "enabled": true,
    "reference": "audio"
  }
}
